      "inputs": [],
      "outputs": [],
      "properties": {
        "Node name for S&R": "MarkdownNote"
      },
      "widgets_values": [
        "## About this workflow\n\nBuilt for this repo on kaushiknishchay's [ComfyUI-Qwen3-ASR](https://github.com/kaushiknishchay/ComfyUI-Qwen3-ASR) (MIT) and Qwen's Qwen3-ASR-1.7B and Qwen3-ForcedAligner-0.6B (Apache-2.0). Grouping, burn-in and the .srt writer are this repo's template pack nodes.\n\nSample clip `dubit_input.mp4` from Lightricks' ComfyUI-LTXVideo examples.\n\nAsset profile: `qwen3-asr-subtitles`."
      ],
      "title": "About this workflow"
    }
